{
  "csv_path": "data/ag/wheat.csv",
  "target_col": "wheat_weekly_rv",
  "target_horizons": [
    1,
    4,
    8,
    12,
    16
  ],
  "use_cache": true,
  "cache_dir": ".cache/benchmark",
  "cache_overwrite": false,
  "target_mode": "mean",
  "core_columns_by_target": {
    "wheat_weekly_rv": [
      "wheat_weekly_rv",
      "wheat_monthly_rv",
      "wheat_seasonal_rv"
    ],
    "corn_weekly_rv": [
      "corn_weekly_rv",
      "corn_monthly_rv",
      "corn_seasonal_rv"
    ],
    "soybeans_weekly_rv": [
      "soybeans_weekly_rv",
      "soybeans_monthly_rv",
      "soybeans_seasonal_rv"
    ]
  },
  "run_configs": {
    "rf_expanding": {
      "walk_forward": {
        "window_type": "expanding",
        "initial_train_size": 208,
        "test_size": 1,
        "step": 1
      },
      "model": {
        "n_estimators": 100,
        "max_depth": 6,
        "min_samples_split": 4,
        "min_samples_leaf": 2,
        "max_features": "sqrt",
        "bootstrap": true,
        "random_state": 42,
        "n_jobs": -1,
        "target_transform": "log",
        "log_transform_rv_features": true
      }
    },
    "rf_rolling": {
      "walk_forward": {
        "window_type": "rolling",
        "initial_train_size": 208,
        "test_size": 1,
        "step": 1,
        "rolling_window_size": 208
      },
      "model": {
        "n_estimators": 100,
        "max_depth": 6,
        "min_samples_split": 4,
        "min_samples_leaf": 2,
        "max_features": "sqrt",
        "bootstrap": true,
        "random_state": 42,
        "n_jobs": -1,
        "target_transform": "log",
        "log_transform_rv_features": true
      }
    }
  }
}
